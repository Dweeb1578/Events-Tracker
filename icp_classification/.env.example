# Slack Bot (create at https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Apollo.io (https://app.apollo.io/#/settings/integrations/api_keys)
APOLLO_API_KEY=your-apollo-api-key

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-key

# Apify (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=apify_api_your-token

# People Data Labs — person enrichment (free tier ~1k/mo). Used PDL-first, Apollo fallback.
PDL_API_KEY=
